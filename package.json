{
  "name": "local-wallet-balance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#wallet-crypto": "./crypto-entry.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node cli.mjs",
    "web": "node server.mjs",
    "build:crypto": "esbuild crypto-entry.mjs --bundle --format=esm --platform=browser --outfile=dist/crypto.mjs",
    "test": "node --test",
    "build:web": "esbuild web/react/main.jsx --bundle --format=esm --platform=browser --minify --outfile=dist/app.js --jsx=automatic && tailwindcss -i web/react/theme.css -o dist/app.css --minify",
    "build": "npm run build:crypto && npm run build:web"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@scure/base": "2.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "ethers": "6.17.0",
    "get-nonce": "1.0.1",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/cli": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
