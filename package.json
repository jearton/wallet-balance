{
  "name": "local-wallet-balance",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#wallet-crypto": "./src/shared/crypto-entry.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/cli/index.js",
    "web": "node dist/server/index.js",
    "build:crypto": "esbuild src/shared/crypto-entry.ts --bundle --format=esm --platform=browser --outfile=dist/crypto.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:web": "esbuild src/client/main.tsx --tsconfig=tsconfig.json --bundle --format=esm --platform=browser --minify --outfile=dist/app.js --jsx=automatic && tailwindcss -i src/client/styles/theme.css -o dist/app.css --minify",
    "build": "npm run build:crypto && npm run build:web && npm run build:server",
    "dev": "node --watch src/server/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build:server": "node scripts/build-server.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "prepare": "node .husky/install.mjs",
    "commit": "git-cz",
    "commitlint": "commitlint",
    "changelog": "node scripts/changelog.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@scure/base": "2.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "ethers": "6.17.0",
    "get-nonce": "1.0.1",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "commitizen": "4.3.2",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "cz-git": "1.14.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jearton/wallet-balance.git"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  }
}
